# 全部运行时配置集中在仓库顶层 help-sale.config.json
# 以下环境变量可覆盖配置文件中的对应项(部署/开发临时覆盖用)
# PORT=3100
# HOST=127.0.0.1
# DATA_DIR=/path/to/data
# TENANT_ID=t_demo
# MODEL_PROVIDER=local-llm
# MODEL_ID=u21-preview
# MODEL_BASE_URL=http://10.252.60.39:31883/v1
# MODEL_API_KEY=local-key
# MODEL_CONTEXT_WINDOW=32768
# MODEL_MAX_TOKENS=8192
# CHUNKER_SIZE=600
# CHUNKER_OVERLAP=80
# KNOWLEDGE_SEARCH_LIMIT=5
# COMPANY_NAME=智造云
# TEAM_NAME=销售团队
# 也可以使用 CONFIG_PATH 指向其他配置文件
# CONFIG_PATH=C:/path/to/help-sale.config.json