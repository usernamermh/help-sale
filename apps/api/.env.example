# 全部运行时配置集中在仓库顶层 help-sale.config.yaml
# 以下环境变量可覆盖配置文件中的对应项(部署/开发临时覆盖用)
# PORT=3100
# HOST=127.0.0.1
# DATA_DIR=/path/to/data
# TENANT_ID=t_demo
# MODEL_PROVIDER=local-llm
# MODEL_ID=u21-preview
# MODEL_BASE_URL=http://your-llm-gateway/v1
# MODEL_API_KEY=your-api-key
# MODEL_PROXY=
# MODEL_CONTEXT_WINDOW=32768
# MODEL_MAX_TOKENS=8192
# 额外模型请求参数(JSON 字符串,覆盖配置文件 model.extraBody;最终统一放进请求体 extra_body 字段)
# MODEL_EXTRA_BODY={"temperature":0.7,"top_p":0.9}
# CHUNKER_SIZE=600
# CHUNKER_OVERLAP=80
# KNOWLEDGE_SEARCH_LIMIT=5
# COMPANY_NAME=智造云
# TEAM_NAME=销售团队
# 也可以使用 CONFIG_PATH 指向其他配置文件
# CONFIG_PATH=C:/path/to/help-sale.config.yaml
# 中间件(连接信息默认在 help-sale.config.yaml,以下可覆盖)
# MYSQL_ENABLED=true
# MYSQL_HOST=your-mysql-host
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=help_sale
# REDIS_ENABLED=true
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=change-me