{
  "name": "table_generate",
  "label": "生成表格/流程图",
  "description": "把结构化二维数组或对象数组转为 Markdown 表格,并可生成 mermaid 流程图/饼图,供前端直接渲染。",
  "category": "呈现",
  "parameters": { "type": "object", "properties": { "title": { "type": "string", "description": "表格标题(可选)" }, "rows": { "type": "array", "description": "二维数组或对象数组(对象时表头取keys)" }, "chartType": { "type": "string", "enum": ["table", "mermaid", "both"], "default": "table" }, "graph": { "type": "array", "description": "流程图边列表 [{from,to,label?}]" }, "pie": { "type": "array", "description": "饼图数据 [{label,value}]" } } },
  "entry": "main.ts",
  "function_list": ["main.execute"]
}