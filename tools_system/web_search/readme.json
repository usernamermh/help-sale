{
  "name": "web_search",
  "label": "网络搜索",
  "description": "通过 Serper(Google 搜索 API)执行网络搜索,返回搜索结果标题/链接/摘要;适用于需要实时外部信息、知识库没有答案、或需要核实最新事实的场景。需要配置 tools.webSearch.apiKey 才能使用。",
  "description_language": "zh",
  "category": "网络",
  "parameters": {
    "type": "object",
    "required": [
      "q"
    ],
    "properties": {
      "q": {
        "type": "string",
        "description": "搜索关键词"
      },
      "num": {
        "type": "number",
        "default": 10,
        "maximum": 20,
        "description": "返回结果条数"
      },
      "gl": {
        "type": "string",
        "description": "国家/地区代码,如 cn/us(可选)"
      },
      "hl": {
        "type": "string",
        "description": "界面语言代码,如 zh-cn/en(可选)"
      }
    }
  },
  "entry": "main.ts",
  "function_list": [
    "main.execute"
  ],
  "requires": [
    {
      "kind": "config",
      "key": "tools.webSearch.apiKey",
      "present": true
    }
  ],
  "toggleable": true
}
