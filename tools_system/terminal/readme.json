{
  "name": "terminal",
  "label": "终端执行",
  "description": "在当前机器执行终端命令并返回输出(默认 15 秒超时)。危险命令(删除/格式化/关机等)已黑名单拦截。仅应在确认安全且必要时使用;优先使用只读命令(查询、列出、检查)。",
  "description_language": "zh",
  "category": "系统",
  "parameters": {
    "type": "object",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "type": "string",
        "description": "要执行的命令,如 dir / pwd / ls / git status"
      },
      "timeoutMs": {
        "type": "number",
        "default": 15000,
        "maximum": 60000,
        "description": "超时毫秒"
      },
      "shell": {
        "type": "string",
        "description": "指定 shell(默认 Windows=cmd,其他=sh)"
      }
    }
  },
  "entry": "main.ts",
  "function_list": [
    "main.execute"
  ],
  "requires": [
    {
      "kind": "always"
    }
  ],
  "toggleable": true
}
