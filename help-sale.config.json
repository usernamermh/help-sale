{
	// ───────────────────────── 服务监听 ─────────────────────────
	"server": {
		// 监听地址:0.0.0.0 允许外部访问;本机调试可改 127.0.0.1
		"host": "0.0.0.0",
		// 服务端口
		"port": 3000
	},

	// ───────────────────────── 数据存储 ─────────────────────────
	"data": {
		// 业务库与会话库所在的目录(相对仓库根;可用 DATA_DIR 覆盖)
		"dataDir": "apps/api/data"
	},

	// ───────────────────────── 多租户 ─────────────────────────
	"tenant": {
		// 默认租户 ID:请求未带 x-tenant-id 头时使用(MVP 固定租户)
		"defaultTenantId": "t_demo"
	},

	// ───────────────────────── 模型接入 ─────────────────────────
	"model": {
		// 提供方:local-llm(内网 OpenAI 兼容端点)/ deepseek / openai
		"provider": "local-llm",
		// 模型名:当前内网端点(u21-preview)支持的模型
		"modelId": "u21-preview",
		// OpenAI 兼容端点根地址(以 /v1 结尾,服务端不校验鉴权)
		"baseUrl": "http://10.252.60.39:31883/v1",
		// 任意 API key(内网端点不校验);对接真实厂商时需改为真实密钥
		"apiKey": "local-key",
		// 模型上下文窗口(token 数),用于向端点声明容量
		"contextWindow": 32768,
		// 单次回复最大输出 token 数
		"maxTokens": 8192,
		// 额外请求参数:会统一放进请求体 body 的 extra_body 字段,
		// 与标准 OpenAI 参数(model/messages/stream/tools…)保持平级而不混杂。
		// 示例(去掉注释即生效):
		// "temperature": 0.7,
		// "top_p": 0.9,
		// "repetition_penalty": 1.05
		"extraBody": {}
	},

	// ───────────────────────── 知识库分块 ─────────────────────────
	"chunker": {
		// 每个知识块的目标字符数(过长的段落会按此切分)
		"size": 600,
		// 相邻知识块之间的重叠字符数,保证跨块上下文不丢失
		"overlap": 80
	},

	// ───────────────────────── 知识检索 ─────────────────────────
	"knowledge": {
		// 每次发起检索默认返回的命中条数(1-10)
		"searchLimit": 5
	},

	// ───────────────────────── 公司与团队 ─────────────────────────
	"company": {
		// 公司名称:写入系统提示词与客户档案上下文
		"name": "智造云",
		// 团队名称:写入系统提示词
		"team": "销售团队"
	}
}