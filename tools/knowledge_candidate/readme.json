{
  "name": "knowledge_candidate",
  "label": "话术质检",
  "description": "查看待确认的沉淀候选(含后台建议:新增/覆盖/跳过),确认入库或拒绝;确认时按建议执行——新增入库、覆盖旧版本、跳过不落库。",
  "category": "话术",
  "parameters": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "enum": [
          "list",
          "approve",
          "reject"
        ],
        "default": "list",
        "description": "操作类型"
      },
      "candidateId": {
        "type": "string",
        "description": "候选 ID(approve/reject 用)"
      },
      "limit": {
        "type": "number",
        "maximum": 100,
        "description": "列表条数上限"
      }
    }
  },
  "entry": "main.ts",
  "function_list": [
    "main.execute"
  ]
}