{
  "name": "playbook_check",
  "label": "话术命中质检",
  "description": "话术命中质检:把某位销售最近 N 条对话(录音转写)的销售发言,与话术库中的标准话术做命中检测——原文命中(照原话说了)与语义命中(表达了同样要点)分开统计,输出命中明细、话术覆盖率与可展示表格。",
  "category": "话术",
  "parameters": {
    "type": "object",
    "properties": {
      "salesName": {
        "type": "string",
        "description": "销售姓名(与 salesId 二选一)"
      },
      "salesId": {
        "type": "string",
        "description": "销售 ID(与 salesName 二选一)"
      },
      "days": {
        "type": "number",
        "default": 30,
        "description": "统计时间范围(近 N 天)"
      },
      "limit": {
        "type": "number",
        "default": 20,
        "description": "最多检查的对话条数"
      },
      "category": {
        "type": "string",
        "default": "话术",
        "description": "话术库分类关键词"
      },
      "threshold": {
        "type": "number",
        "default": 0.72,
        "description": "语义命中相似度阈值(0-1)"
      }
    }
  },
  "entry": "main.ts",
  "function_list": [
    "main.execute"
  ]
}
