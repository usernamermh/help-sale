{
  "name": "playbook_check",
  "label": "话术命中检测",
  "description": "话术命中检测:用对话原文中销售角色的发言,与话术库中已入库的标准话术做原文/语义双通道匹配(话术候选不参与),返回命中明细、命中方式与话术覆盖率。",
  "category": "话术",
  "parameters": {
    "type": "object",
    "properties": {
      "salesName": {
        "type": "string",
        "description": "销售姓名(与 salesId 二选一)"
      },
      "salesId": {
        "type": "string",
        "description": "销售 ID(与 salesName 二选一)"
      },
      "days": {
        "type": "number",
        "default": 30,
        "description": "统计时间范围(近 N 天)"
      },
      "limit": {
        "type": "number",
        "default": 20,
        "description": "最多检查的对话条数"
      },
      "category": {
        "type": "string",
        "default": "话术",
        "description": "话术库分类关键词"
      },
      "threshold": {
        "type": "number",
        "default": 0.72,
        "description": "语义命中相似度阈值(0-1)"
      }
    }
  },
  "entry": "main.ts",
  "function_list": [
    "main.execute"
  ]
}
